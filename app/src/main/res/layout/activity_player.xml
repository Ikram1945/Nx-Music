<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_main_gradient"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- ===== Header: kembali + label NOW PLAYING + antrian ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_back"
                android:tint="@color/white"
                android:contentDescription="@string/back"
                android:padding="11dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/title_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing_label"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:letterSpacing="0.18"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="28dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/primary"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_open_list"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_queue"
                android:tint="@color/white"
                android:contentDescription="@string/open_song_list"
                android:padding="11dp"/>
        </LinearLayout>

        <!-- ===== Sapaan selamat datang + penyemangat ===== -->
        <LinearLayout
            android:id="@+id/greeting_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_now_playing"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/bar_pulse_1"
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_bar_fill"
                    android:backgroundTint="@color/primary"/>

                <View
                    android:id="@+id/bar_pulse_2"
                    android:layout_width="4dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_bar_fill"
                    android:backgroundTint="@color/primary"/>

                <View
                    android:id="@+id/bar_pulse_3"
                    android:layout_width="4dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_bar_fill"
                    android:backgroundTint="@color/primary"/>

                <View
                    android:id="@+id/bar_pulse_4"
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_bar_fill"
                    android:backgroundTint="@color/primary"/>

                <View
                    android:id="@+id/bar_pulse_5"
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_bar_fill"
                    android:backgroundTint="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/greeting_default"/>

                <TextView
                    android:id="@+id/txt_motivation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/motivation_1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Artwork besar + glow ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/art_glow"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_artwork_glow"/>

            <ImageView
                android:id="@+id/art_now_playing"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_artwork_large"
                android:padding="44dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note"
                android:tint="@color/white"
                android:contentDescription="@string/music_icon"/>
        </FrameLayout>

        <!-- ===== Judul & artis ===== -->
        <TextView
            android:id="@+id/title_now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/no_playing"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"/>

        <TextView
            android:id="@+id/artist_now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/no_playing_artist"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"/>

        <!-- Informasi sleep timer (muncul saat aktif) -->
        <TextView
            android:id="@+id/txt_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_now_playing"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text=""/>

        <!-- ===== Seekbar + waktu ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:minWidth="38dp"/>

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"
                android:progressBackgroundTint="@color/surface_container_high"/>

            <TextView
                android:id="@+id/txt_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:gravity="end"
                android:minWidth="38dp"/>
        </LinearLayout>

        <!-- ===== Bar spectrum real-time ===== -->
        <com.nx.music.SpectrumView
            android:id="@+id/spectrum_view"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"/>

        <!-- ===== Kartu info lagu (uji pipeline: ID baru) ===== -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_now_playing"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txt_info_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/info_title"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txt_info_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="-"/>
        </LinearLayout>

        <!-- ===== Kontrol utama: shuffle / prev / play / next / repeat ===== -->
        <LinearLayout
            android:id="@+id/control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/white"
                android:contentDescription="@string/shuffle"
                android:padding="11dp"/>

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_prev"
                android:tint="@color/white"
                android:contentDescription="@string/prev"
                android:padding="12dp"/>

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_play_button_modern"
                android:src="@drawable/ic_play"
                android:tint="@color/white"
                android:contentDescription="@string/play"
                android:padding="20dp"/>

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_next"
                android:tint="@color/white"
                android:contentDescription="@string/next"
                android:padding="12dp"/>

            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_repeat"
                android:tint="@color/white"
                android:contentDescription="@string/repeat"
                android:padding="11dp"/>
        </LinearLayout>

        <!-- ===== Kontrol sekunder: EQ / efek audio / sleep timer ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_now_playing"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/btn_equalizer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_equalizer"
                android:tint="@color/white"
                android:contentDescription="@string/equalizer"
                android:padding="12dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:background="@color/divider"/>

            <ImageButton
                android:id="@+id/btn_audio_effects"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_audio_effects"
                android:tint="@color/white"
                android:contentDescription="@string/audio_effects"
                android:padding="12dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:background="@color/divider"/>

            <ImageButton
                android:id="@+id/btn_sleep_timer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_sleep_timer"
                android:tint="@color/white"
                android:contentDescription="@string/sleep_timer"
                android:padding="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
