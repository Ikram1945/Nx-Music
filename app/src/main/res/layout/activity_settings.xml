<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_main_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:padding="11dp"
            android:contentDescription="@string/back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_summary"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/primary"
            android:contentDescription="@string/settings"/>
    </LinearLayout>

    <!-- Konten scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ===== Mode Tampilan ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="8dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/white"
                            android:contentDescription="@string/settings_theme"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_theme"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_theme_summary"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/group_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/theme_follow_system"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/theme_follow_system"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/theme_light"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/theme_dark"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Urutan Daftar Lagu ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="8dp"
                            android:src="@drawable/ic_queue"
                            android:tint="@color/white"
                            android:contentDescription="@string/settings_sort"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_sort"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_sort_summary"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/group_sort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/sort_default"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/sort_default"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/sort_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/sort_title"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/sort_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/sort_artist"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/sort_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/sort_duration"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Tema Kustom ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="8dp"
                            android:src="@drawable/ic_equalizer"
                            android:tint="@color/white"
                            android:contentDescription="@string/settings_custom_theme"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_custom_theme"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_custom_theme_summary"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/group_custom_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/custom_theme_default"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_default"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/custom_theme_blue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_blue"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/custom_theme_green"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_green"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/custom_theme_purple"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_purple"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/custom_theme_orange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_orange"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                        <RadioButton
                            android:id="@+id/custom_theme_red"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_setting_option"
                            android:buttonTint="@color/setting_radio_fixed"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/custom_theme_red"
                            android:textColor="@color/setting_option_text"
                            android:textSize="14sp"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Crossfade ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="8dp"
                            android:src="@drawable/ic_audio_effects"
                            android:tint="@color/white"
                            android:contentDescription="@string/crossfade"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/crossfade"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/crossfade_summary"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_crossfade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_setting_option"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/crossfade_enable"
                        android:textColor="@color/setting_option_text"
                        android:thumbTint="@color/setting_radio_fixed"
                        android:trackTint="@color/setting_option_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Riwayat & Statistik ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            android:padding="8dp"
                            android:src="@drawable/ic_statistics"
                            android:tint="@color/white"
                            android:contentDescription="@string/settings_history"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_history"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_empty"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_clear_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/error"
                        android:minHeight="48dp"
                        android:text="@string/clear_history"
                        android:textColor="@color/on_error"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
