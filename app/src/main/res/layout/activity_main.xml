<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <!-- Header: judul brand + bar equalizer satu baris, subtitle tipis di bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/home_bar_1"
                        android:layout_width="3dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_bar_fill"
                        android:backgroundTint="@color/primary"/>

                    <View
                        android:id="@+id/home_bar_2"
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_bar_fill"
                        android:backgroundTint="@color/primary"/>

                    <View
                        android:id="@+id/home_bar_3"
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_bar_fill"
                        android:backgroundTint="@color/primary"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txt_home_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/header_greeting"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_play_now"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_play_circle"
            android:src="@drawable/ic_play"
            android:tint="@color/white"
            android:padding="14dp"
            android:contentDescription="@string/play"/>
    </LinearLayout>

    <!-- Daftar lagu: SATU ListView mengisi sisa tinggi.
         Header (judul "baru diputar" + deretan kartunya + judul "daftar lagu")
         dipasang lewat ListView.addHeaderView() dari MainActivity.
         Tidak memakai ScrollView/ListView bersarang: keduanya mengukur seluruh
         baris sekaligus dan membuat section bertumpuk. -->
    <ListView
        android:id="@+id/list_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="8dp"/>

    <!-- Mini-player menempel di atas bottom-nav: artwork, judul/artis, play/next.
         Klik di kartu (selain tombol play/next) membuka PlayerActivity. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/primary_container"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/on_primary_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/mini_art"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_artwork_gradient"
                android:clipToOutline="true"
                android:contentDescription="@string/music_icon"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:tint="@color/on_primary_container"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_playing"
                    android:textColor="@color/on_primary_container"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/mini_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_playing_artist"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_mini_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:tint="@color/on_primary_container"
                android:padding="11dp"
                android:contentDescription="@string/play"/>

            <ImageButton
                android:id="@+id/btn_mini_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="@color/on_primary_container"
                android:padding="11dp"
                android:contentDescription="@string/next"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/menu_main"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"/>
</LinearLayout>
