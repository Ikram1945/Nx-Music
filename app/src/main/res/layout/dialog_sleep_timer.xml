<?xml version="1.0" encoding="utf-8"?>
<!-- Layout dialog Sleep Timer (fitur #2): status sisa waktu, chip durasi,
     dan menit kustom. Dipakai PlayerActivity.showSleepTimerDialog(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="4dp">

    <!-- Header: ikon + judul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sleep_timer"
            android:tint="@color/primary"
            android:contentDescription="@string/sleep_timer"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="@string/sleep_timer_title"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sleep_timer_hint"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"/>

    <!-- Status: sisa waktu saat timer aktif, diperbarui tiap detik dari kode -->
    <TextView
        android:id="@+id/txt_sleep_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_now_playing"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/sleep_timer_inactive"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sleep_timer_choose_duration"
        android:textColor="@color/on_surface"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Pilihan durasi: satu chip terpilih pada satu waktu -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_sleep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_off"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_off"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_10"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_10"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_15"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_15"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_20"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_20"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_30"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_30"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_45"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_45"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_60"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_60"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_90"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_90"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sleep_120"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sleep_timer_120"/>
    </com.google.android.material.chip.ChipGroup>

    <!-- Durasi bebas: dipakai bila diisi, mengalahkan chip -->
    <EditText
        android:id="@+id/edt_sleep_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/sleep_timer_custom_hint"
        android:inputType="number"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/sleep_timer_custom_note"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"/>
</LinearLayout>
